# Copy to .env.local for local dev
# Set these in Vercel dashboard → Settings → Environment Variables

# Suno API key (apibox.erweima.ai)
VITE_SUNO_API_KEY=

# Your deployment URL (used to construct webhook callback)
# Set to your Vercel URL e.g. https://saia-omega.vercel.app
VITE_APP_URL=https://saia-omega.vercel.app
